---
export const SITE = 'Открытый Тольятти';
const SITE_URL = 'https://opentgl.github.io';
export const SITE_TITLE = 'Открытый Тольятти — портал открытых данных';
export const SITE_DESCRIPTION = 'Открытые данные города Тольятти: транспорт, культура, образование, спорт, здравоохранение, недвижимость и инфраструктура. Независимый портал на основе данных администрации г.о. Тольятти.';

export interface Props {
  title?: string;
  description?: string;
  hideHero?: boolean;
  fill?: boolean;
}
const { title, description, hideHero, fill } = Astro.props;
const pageTitle = title ? `${title} | ${SITE}` : SITE_TITLE;
const pageDesc = description || SITE_DESCRIPTION;
const truncatedTitle = pageTitle.length > 65 ? pageTitle.slice(0, 62) + '...' : pageTitle;
const truncatedDesc = pageDesc.length > 160 ? pageDesc.slice(0, 157) + '...' : pageDesc;
const b = import.meta.env.BASE_URL;
const canonical = Astro.url.href;
const imageUrl = `${SITE_URL}/og-image.png`;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{truncatedTitle}</title>
    <meta name="description" content={truncatedDesc} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href={`${b}favicon.ico`} sizes="any" media="(prefers-color-scheme: light)" type="image/x-icon">
    <link rel="icon" href={`${b}dark/favicon.ico`} sizes="any" media="(prefers-color-scheme: dark)" type="image/x-icon">
    <link rel="icon" href={`${b}favicon.svg`} type="image/svg+xml">

    <!-- Yandex Webmaster -->
    <meta name="yandex-verification" content="291a9c150f31096d" />
    <!-- Google Search Console -->
    <meta name="google-site-verification" content="-nuKrMdT_m1o6A0XNjjwHA4N2hVC8SMQ36gyJmLmBzo" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE} />
    <meta property="og:title" content={truncatedTitle} />
    <meta property="og:description" content={truncatedDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content="ru_RU" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={truncatedTitle} />
    <meta name="twitter:description" content={truncatedDesc} />
    <meta name="twitter:image" content={imageUrl} />

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Открытый Тольятти",
      "alternateName": "Open Togliatti",
      "url": "https://opentgl.github.io"
    }
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400..700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href={`${b}css/style.css`} rel="stylesheet" />
    <link rel="preload" href="https://unpkg.com/lucide@0.468.0/dist/umd/lucide.js" as="script" fetchpriority="high" />
  </head>
  <body class={`d-flex flex-column min-vh-100 ${fill ? 'route-page' : ''}`}>
    <slot name="navbar" />
    {!hideHero && (
      <div class="bg-dark text-white mt-2 mb-2 d-flex flex-column justify-content-center position-relative" style={`background-image: url('${b}plane.jpg'); background-size: cover; background-position: center; min-height: 300px;`}>
        <div class="container py-4 py-md-5">
          <h1 class="fw-bold m-0">Открытые данные Тольятти</h1>
        </div>
      </div>
    )}
    <slot name="navstrip" />
    <script is:inline src="https://unpkg.com/lucide@0.468.0/dist/umd/lucide.js"></script>
    <div class="app-body">
      <main class="flex-grow-1">
        <div class="container py-3">
          <slot />
        </div>
      </main>
    </div>
    <slot name="footer" />
    <script is:inline src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script is:inline>
      if (typeof lucide !== 'undefined') {
        lucide.createIcons();
      } else {
        document.addEventListener('DOMContentLoaded', () => lucide.createIcons());
      }
    </script>
  </body>
</html>

<style is:global>
  .route-page {
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
  }
  .route-page .app-body {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }
  .route-page .app-body main {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }
  .route-page .app-body main > .container {
    flex-grow: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  @media (max-width: 991.98px) {
    .route-page {
      height: auto;
      overflow: visible;
    }
    .route-page .app-body main {
      display: block;
      flex: none;
    }
    .route-page .app-body main > .container {
      display: block;
      overflow: visible;
    }
  }
</style>
