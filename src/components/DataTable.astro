---
const { headers, objects, eventIds } = Astro.props;
const base = import.meta.env.BASE_URL;

function esc(s) {
  if (s == null) return '';
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function linkify(key, value) {
  if (!value) return '<span class="text-muted">&mdash;</span>';
  const raw = String(value).trim();
  const k = key.toLowerCase();
  if (k.includes('почт') || k.includes('email') || k.includes('e-mail')) {
    return raw.split(/[,;]/).map(e => e.trim()).filter(Boolean).map(e => `<i data-lucide="mail" width="14" height="14" class="me-1"></i><a href="mailto:${esc(e)}" class="text-decoration-none">${esc(e)}</a>`).join('<br>');
  }
  if (k.includes('телефон') || k.includes('тел')) {
    return raw.split(/[,;]/).map(p => p.trim()).filter(Boolean).map(p => {
      const d = p.replace(/\D/g, '');
      return d ? `<i data-lucide="phone" width="14" height="14" class="me-1"></i><a href="tel:${d}" class="text-decoration-none">${esc(p)}</a>` : esc(p);
    }).join('<br>');
  }
  if (k.includes('сайт') || k.includes('web') || k.includes('url')) {
    const url = raw.startsWith('http') ? raw : 'https://' + raw;
    return `<i data-lucide="globe" width="14" height="14" class="me-1"></i><a href="${esc(url)}" target="_blank" rel="noopener" class="text-decoration-none">${esc(raw)}</a>`;
  }
  if (k.includes('адрес') || k.includes('местополож') || k.includes('местонахожд')) {
    return `<i data-lucide="map-pin" width="14" height="14" class="me-1"></i><a href="https://2gis.ru/togliatti/search/${encodeURIComponent(raw)}" target="_blank" rel="noopener" class="text-decoration-none">${esc(raw)}</a>`;
  }
  return esc(raw);
}
---

<div class="table-responsive" data-paginated-table style="max-height: 600px; overflow-y: auto;">
  <table class="table table-hover table-sm mb-0">
    <thead class="table-light" style="position: sticky; top: 0; z-index: 1;">
      <tr>
        {headers.map(h => <th class="text-nowrap">{esc(h)}</th>)}
        {eventIds && <th class="text-nowrap">Лента событий</th>}
      </tr>
    </thead>
    <tbody>
      {objects.map((obj, index) => (
        <tr>
          {headers.map(h => <td set:html={linkify(h, obj[h])} />)}
          {eventIds && (
            <td class="text-nowrap">
              {eventIds[index] ? (
                <a
                  href={`${base}events/${eventIds[index]}/`}
                  class="btn btn-sm btn-outline-primary"
                  title="Показать ленту событий учреждения"
                >
                  Лента событий
                </a>
              ) : null}
            </td>
          )}
        </tr>
      ))}
    </tbody>
  </table>
  <div class="p-2 text-center" data-table-pagination>
    <button type="button" class="btn btn-sm btn-outline-secondary" data-table-more hidden={objects.length <= 10}>
      Показать ещё 10 строк
    </button>
  </div>
</div>

<script>
  (() => {
    const pageSize = 10;

    function rowsWord(count) {
      const mod10 = count % 10;
      const mod100 = count % 100;
      if (mod10 === 1 && mod100 !== 11) return 'строку';
      if (mod10 >= 2 && mod10 <= 4 && (mod100 < 12 || mod100 > 14)) return 'строки';
      return 'строк';
    }

    document.querySelectorAll('[data-paginated-table]').forEach(container => {
      if (container.dataset.paginationReady === 'true') return;
      container.dataset.paginationReady = 'true';

      const rows = Array.from(container.querySelectorAll('tbody tr'));
      const more = container.querySelector('[data-table-more]');
      if (!rows.length || !more) return;

      let shown = Math.min(pageSize, rows.length);
      rows.forEach((row, index) => {
        if (index >= shown) row.hidden = true;
      });

      function updateButton() {
        const remaining = rows.length - shown;
        if (remaining <= 0) {
          more.hidden = true;
          return;
        }

        const next = Math.min(pageSize, remaining);
        more.hidden = false;
        more.textContent = `Показать ещё ${next} ${rowsWord(next)}`;
      }

      function showMore() {
        if (shown >= rows.length) return;
        const next = Math.min(shown + pageSize, rows.length);
        for (let i = shown; i < next; i++) rows[i].hidden = false;
        shown = next;
        updateButton();
      }

      more.addEventListener('click', showMore);
      container.addEventListener('scroll', () => {
        if (container.scrollTop + container.clientHeight >= container.scrollHeight - 80) {
          showMore();
        }
      }, { passive: true });

      updateButton();
    });
  })();
</script>
