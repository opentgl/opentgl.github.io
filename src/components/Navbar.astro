---
const base = import.meta.env.BASE_URL;
---
<style is:global>
  .navbar.sticky-top {
    z-index: 2000;
  }
  @media (max-width: 991.98px) {
    .navbar .mobile-brand .navbar-brand {
      margin-right: 0;
      text-align: center;
    }
    .navbar .mobile-brand .dropdown-menu {
      min-width: 12rem;
    }
  }
</style>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top">
  <div class="container">
    <a class="navbar-brand fw-bold d-none d-lg-block" href={base}>Открытый Тольятти</a>
    <div class="dropdown mobile-brand d-lg-none mx-auto">
      <button
        class="navbar-brand fw-bold border-0 bg-transparent dropdown-toggle"
        type="button"
        data-bs-toggle="dropdown"
        aria-expanded="false"
        aria-haspopup="true"
      >
        Открытый Тольятти
      </button>
      <ul class="dropdown-menu">
        <li><a class="dropdown-item" href={base}>Главная</a></li>
        <li><a class="dropdown-item" href={`${base}map`}>Карта</a></li>
        <li><a class="dropdown-item" href={`${base}route`}>Маршруты</a></li>
        <li><a class="dropdown-item" href={`${base}about`}>О сайте</a></li>
      </ul>
    </div>
    <div class="collapse navbar-collapse" id="topNav">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item">
          <a class="nav-link" href={`${base}map`}>Карта</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href={`${base}route`}>Маршруты</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href={`${base}about`}>О сайте</a>
        </li>
      </ul>
    </div>
  </div>
</nav>
