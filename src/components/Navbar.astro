---
const base = import.meta.env.BASE_URL;
---
<style is:global>
  @media (max-width: 991.98px) {
    .navbar .navbar-brand {
      flex: 1;
      text-align: center;
    }
  }
</style>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top">
  <div class="container">
    <a class="navbar-brand fw-bold" href={base}>Открытый Тольятти</a>
    <div class="collapse navbar-collapse" id="topNav">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item">
          <a class="nav-link" href={`${base}route`}>Маршруты</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href={`${base}about`}>О сайте</a>
        </li>
      </ul>
    </div>
  </div>
</nav>
