---
import { readFileSync } from 'node:fs';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import { loadRoutes, loadStopCoords, candidatesFor, pickPoint } from '../lib/routes.js';

const coords = loadStopCoords();
const routes = await loadRoutes();

const normNum = s => String(s || '').replace(/[№#\s]/g, '').trim();
let scheduleNums = new Set();
try {
  scheduleNums = new Set(JSON.parse(readFileSync(new URL('../../public/data/schedules/index.json', import.meta.url), 'utf8')));
} catch {}

const routesData = routes.map(r => {
  const points = [];
  let prev = null;
  for (const s of r.stops) {
    const cands = candidatesFor(coords, s);
    const c = pickPoint(cands, prev);
    if (c) {
      points.push({ name: s, lat: c.lat, lon: c.lon });
      prev = c;
    }
  }
  return {
    id: r.id,
    num: r.num,
    name: r.name,
    transport: r.transport,
    color: r.color,
    points,
    totalStops: r.stops.length,
    hasSchedule: scheduleNums.has(normNum(r.num)),
  };
});

const groups = ['Автобус', 'Троллейбус', 'Маршрутное такси']
  .map(transport => ({
    transport,
    items: routesData
      .map((r, i) => ({ index: i, num: r.num, name: r.name, transport: r.transport, hasSchedule: r.hasSchedule }))
      .filter(it => routesData[it.index].transport === transport)
      .sort((a, b) => a.num.localeCompare(b.num, 'ru', { numeric: true })),
  }))
  .filter(g => g.items.length);
---

<Layout title="Маршруты на карте" hideHero fill
  breadcrumbs={[
    { name: 'Открытый Тольятти', url: 'https://opentgl.github.io' },
    { name: 'Маршруты на карте', url: 'https://opentgl.github.io/route/' },
  ]}
  faviconBase="https://opentgl.github.io/">
  <Fragment slot="navbar"><Navbar /></Fragment>

  <style is:global>
    mark {
      background-color: #ffe066;
      color: #000;
      padding: 0 1px;
      border-radius: 2px;
    }
    .route-item.has-schedule {
      background-color: #f0f7ff;
    }
    .route-item.has-schedule .route-num {
      background-color: #0d6efd;
    }
    .route-item .schedule-badge {
      color: #0d6efd;
    }
    .route-item.active .schedule-badge {
      color: #fff;
    }
    .route-item.active.has-schedule {
      background-color: var(--bs-list-group-active-bg, #0d6efd);
      border-color: var(--bs-list-group-active-border-color, #0d6efd);
      color: var(--bs-list-group-active-color, #fff);
    }
    .route-item.active.has-schedule .route-num {
      background-color: #212529;
    }
    #schedule-btn.available {
      background-color: #0d6efd;
      border-color: #0d6efd;
      color: #fff;
    }
    #schedule-btn.available:hover {
      background-color: #0b5ed7;
      border-color: #0a58ca;
      color: #fff;
    }
    #schedule-btn.available:active {
      background-color: #0a58ca;
      border-color: #0a53be;
      color: #fff;
    }
    #schedule-btn:not(.available) {
      background-color: #6c757d;
      border-color: #6c757d;
      color: #fff;
    }
    #schedule-btn:not(.available):hover {
      background-color: #5c636a;
      border-color: #565e64;
    }
  </style>

  <style>
    .route-groups-card {
      display: flex;
      flex-direction: column;
      min-height: 0;
      border-radius: 0.75rem;
      overflow: hidden;
    }
    .route-groups-card .card-body {
      flex: 1 1 auto;
      min-height: 0;
      padding: 0.375rem;
      display: flex;
      flex-direction: column;
    }
    @media (min-width: 992px) {
      .route-layout {
        flex-grow: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
      }
      .route-row {
        flex-wrap: nowrap;
        flex-grow: 1;
        min-height: 0;
      }
      .route-side {
        display: flex;
        flex-direction: column;
        min-height: 0;
      }
      .route-side .input-group {
        flex-shrink: 0;
      }
      .route-groups-card {
        flex-grow: 1;
      }
      .route-groups {
        flex-grow: 1;
        min-height: 0;
        overflow-y: auto;
      }
      .route-map-col {
        display: flex;
        min-height: 0;
      }
      .route-map {
        flex: 1 1 auto;
        min-height: 0;
      }
    }
    @media (max-width: 991.98px) {
      .route-groups {
        max-height: 55vh;
        overflow-y: auto;
      }
      .route-map {
        height: 60vh;
      }
    }
  </style>

  <div class="route-layout">
    <div class="row g-3 route-row">
      <div class="col-lg-4 col-xl-3 route-side">
        <div class="input-group mb-2">
          <input id="route-search" type="search" class="form-control" placeholder="Поиск маршрута..." autocomplete="off" />
          <span class="input-group-text"><i data-lucide="search" width="18" height="18" /></span>
        </div>
        <select id="route-transport-filter" class="form-select mb-2" aria-label="Фильтр по виду транспорта">
          <option value="all">Все виды транспорта</option>
          {groups.map(g => (
            <option value={g.transport}>{g.transport}</option>
          ))}
        </select>
        <div class="card route-groups-card">
          <div class="card-body">
            <div id="route-groups" class="route-groups">
              {groups.map(g => (
                <section class="mb-3" data-group={g.transport}>
                  <h2 class="fs-6 fw-bold text-secondary border-bottom pb-1 mb-2">{g.transport}</h2>
                  <div class="list-group">
                    {g.items.map(it => (
                      <button type="button" class={"route-item list-group-item list-group-item-action d-flex align-items-center gap-2 py-2" + (it.hasSchedule ? ' has-schedule' : '')}
                        data-index={it.index} data-num={it.num} data-name={it.name}
                        data-transport={it.transport}>
                        <span class="route-num badge rounded-pill text-bg-dark">{it.num}</span>
                        <span class="route-name small" data-orig-name={it.name}>{it.name}</span>
                        {it.hasSchedule && (
                          <span class="schedule-badge ms-auto" title="Есть расписание">
                            <i data-lucide="calendar-clock" width="14" height="14" />
                          </span>
                        )}
                      </button>
                    ))}
                  </div>
                </section>
              ))}
            </div>
          </div>
        </div>
        <button type="button" id="schedule-btn" class="btn w-100 mt-2" disabled>
          <i data-lucide="calendar-clock" width="16" height="16" class="me-1" />
          <span id="schedule-btn-label">Расписание</span>
        </button>
      </div>
      <div class="col-lg-8 col-xl-9 route-map-col">
        <div id="map" class="route-map rounded shadow-sm"></div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="schedule-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="schedule-modal-title">Расписание</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
        </div>
        <div class="modal-body" id="schedule-modal-body"></div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
        </div>
      </div>
    </div>
  </div>

  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <div id="routes-data" hidden>{JSON.stringify(routesData)}</div>

  <script is:inline>
    (function () {
      var data = JSON.parse(document.getElementById('routes-data').textContent);

      var map = L.map('map', { zoomControl: true }).setView([53.5076, 49.4194], 12);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      }).addTo(map);

      var layerGroup = L.layerGroup().addTo(map);
      window.addEventListener('load', function () { map.invalidateSize(); });

      var items = Array.prototype.slice.call(document.querySelectorAll('.route-item'));
      var groups = Array.prototype.slice.call(document.querySelectorAll('#route-groups > section'));
      var transportFilter = document.getElementById('route-transport-filter');
      var search = document.getElementById('route-search');
      var scheduleBtn = document.getElementById('schedule-btn');
      var scheduleBtnLabel = document.getElementById('schedule-btn-label');
      var scheduleModalEl = document.getElementById('schedule-modal');
      var scheduleModalTitle = document.getElementById('schedule-modal-title');
      var scheduleModalBody = document.getElementById('schedule-modal-body');

      function normNum(s) {
        return String(s == null ? '' : s).replace(/[№#\s]/g, '').trim();
      }

      function activeTransports() {
        var v = transportFilter.value;
        var set = {};
        Array.prototype.forEach.call(transportFilter.querySelectorAll('option'), function (o) {
          if (v === 'all' || o.value === v) set[o.value] = true;
        });
        return set;
      }

      function esc(s) {
        return String(s).replace(/[&<>"']/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
      }

      // Выделяет ВСЕ вхождения запроса в строке жёлтым (без учёта регистра).
      function markAll(text, ql) {
        var s = String(text);
        var sl = s.toLowerCase();
        var q = String(ql);
        var out = '';
        var i = 0, idx;
        while ((idx = sl.indexOf(q, i)) >= 0) {
          out += esc(s.slice(i, idx)) + '<mark>' + esc(s.slice(idx, idx + q.length)) + '</mark>';
          i = idx + q.length;
        }
        out += esc(s.slice(i));
        return out;
      }

      function applySearch() {
        var q = search.value.trim();
        var ql = q.toLowerCase();
        var active = activeTransports();
        items.forEach(function (item) {
          var nameEl = item.querySelector('.route-name');
          // Оригинальное название всегда в data-orig-name — mark'и его не меняют,
          // поэтому фильтр всегда ищет по исходному тексту, а не по подсветке.
          var orig = nameEl ? nameEl.dataset.origName : '';
          var hit = ql ? orig.toLowerCase().indexOf(ql) >= 0 : true;
          if (hit && !active[item.dataset.transport]) hit = false;
          if (!hit) {
            item.style.setProperty('display', 'none', 'important');
            if (nameEl) nameEl.innerHTML = esc(orig);
            return;
          }
          item.style.removeProperty('display');
          if (nameEl) nameEl.innerHTML = ql ? markAll(orig, ql) : esc(orig);
        });
        groups.forEach(function (g) {
          var visible = Array.prototype.some.call(g.querySelectorAll('.route-item'), function (it) {
            return it.style.display !== 'none';
          });
          g.style.display = visible ? '' : 'none';
        });
      }

      search.addEventListener('input', applySearch);
      transportFilter.addEventListener('change', applySearch);

      function updateScheduleButton() {
        var r = data[activeIndex];
        var avail = !!(r && r.hasSchedule);
        scheduleBtn.disabled = !avail;
        scheduleBtnLabel.textContent = avail ? 'Доступно расписание' : 'Расписание';
        scheduleBtn.classList.toggle('available', avail);
      }

      function renderSchedule(sch) {
        var out = '';
        if (sch.title) out += '<div class="fs-5 fw-semibold">' + esc(sch.title) + '</div>';
        if (sch.name) out += '<div class="text-secondary">' + esc(sch.name) + '</div>';
        if (sch.date) out += '<div class="text-secondary small mb-2">Действует с ' + esc(sch.date) + '</div>';
        (sch.groups || []).forEach(function (g) {
          out += '<div class="mb-3">';
          out += '<div class="fw-semibold border-bottom pb-1 mb-2">' + esc(g.label) + '</div>';
          out += '<div class="table-responsive"><table class="table table-sm table-bordered align-middle mb-0"><thead><tr>';
          g.columns.forEach(function (c) { out += '<th scope="col">' + esc(c.stop || '') + '</th>'; });
          out += '</tr></thead><tbody>';
          var n = 0;
          g.columns.forEach(function (c) { if (c.times.length > n) n = c.times.length; });
          for (var i = 0; i < n; i++) {
            out += '<tr>';
            g.columns.forEach(function (c) { out += '<td>' + esc(c.times[i] || '') + '</td>'; });
            out += '</tr>';
          }
          out += '</tbody></table></div></div>';
        });
        return out;
      }

      scheduleBtn.addEventListener('click', function () {
        var r = data[activeIndex];
        if (!r || !r.hasSchedule) return;
        var num = encodeURIComponent(normNum(r.num));
        fetch('/data/schedules/' + num + '.json')
          .then(function (res) {
            if (!res.ok) throw new Error('HTTP ' + res.status);
            return res.json();
          })
          .then(function (sch) {
            scheduleModalTitle.textContent = r.num ? ('Расписание маршрута № ' + r.num.replace(/№\s*/i, '')) : 'Расписание';
            scheduleModalBody.innerHTML = renderSchedule(sch);
            bootstrap.Modal.getOrCreateInstance(scheduleModalEl).show();
          })
          .catch(function (err) {
            scheduleModalBody.innerHTML = '<div class="text-danger">Не удалось загрузить расписание: ' + esc(err.message) + '</div>';
            bootstrap.Modal.getOrCreateInstance(scheduleModalEl).show();
          });
      });

      var routeCache = {};
      var lineLayer = null;

      function draw(route, index) {
        layerGroup.clearLayers();
        lineLayer = null;
        if (!route || !route.points.length) return;

        route.points.forEach(function (p, i) {
          var marker = L.circleMarker([p.lat, p.lon], {
            radius: 5,
            fillColor: route.color,
            color: '#fff',
            weight: 1.5,
            fillOpacity: 1,
          });
          marker.bindPopup('<strong>' + esc(p.name) + '</strong><br><small>Остановка ' + (i + 1) + ' из ' + route.points.length + '</small>');
          marker.addTo(layerGroup);
        });

        drawAlongRoads(route, index);
      }

      function polylineOptions(route) {
        return { color: route.color, weight: 4, opacity: 0.85 };
      }

      // Рисует линию строго по дорогам — локально, A* по графу OSM (Web Worker).
      // Пока граф не готов или маршрут не посчитан — прямые отрезки между остановками.
      function setLine(coords, route) {
        if (lineLayer) layerGroup.removeLayer(lineLayer);
        lineLayer = L.polyline(coords, polylineOptions(route)).addTo(layerGroup);
      }

      function drawAlongRoads(route, index) {
        if (!route.points.length || !window.fetch) return;
        var cached = routeCache[route.id];
        if (cached) {
          if (activeIndex === index) setLine(cached, route);
          return;
        }
        if (cached === false) {
          if (activeIndex === index) setLine(route.points.map(function (p) { return [p.lat, p.lon]; }), route);
          return;
        }
        setLine(route.points.map(function (p) { return [p.lat, p.lon]; }), route);
        if (!window.routeOnRoads) return;
        window.routeOnRoads(route.points).then(function (coords) {
          if (!coords || !coords.length) { routeCache[route.id] = false; return; }
          routeCache[route.id] = coords;
          if (activeIndex !== index) return;
          setLine(coords, route);
        }).catch(function () { routeCache[route.id] = false; });
      }

      var activeIndex = 0;

      // Вызывается модулем клиентского роутинга, когда граф дорог загрузился:
      // пересчитывает текущий маршрут по дорогам вместо прямых отрезков.
      window.__routingRefresh = function () {
        if (!data || activeIndex === undefined) return;
        var r = data[activeIndex];
        if (!r || routeCache[r.id] !== undefined) return;
        drawAlongRoads(r, activeIndex);
      };
      window.__routingError = function (message) {
        console.warn('Маршрутизация по дорогам недоступна: ' + message);
      };

      items.forEach(function (item) {
        item.addEventListener('click', function () {
          items.forEach(function (x) { x.classList.remove('active'); });
          item.classList.add('active');
          activeIndex = parseInt(item.dataset.index, 10);
          draw(data[activeIndex], activeIndex);
          updateScheduleButton();
        });
      });

      applySearch();

      var first = 0;
      for (var i = 0; i < data.length; i++) {
        if (data[i].points.length) { first = i; break; }
      }
      activeIndex = first;
      if (items[first]) items[first].classList.add('active');
      draw(data[first], first);
      updateScheduleButton();
    })();
  </script>

  <script>
    import { routeOnRoads } from '../lib/routing/route-app.js';
    window.routeOnRoads = routeOnRoads;
    if (window.__routingRefresh) window.__routingRefresh();
  </script>
</Layout>
