---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { loadAllMeta, getCategories } from '../lib/csv-data.js';
const base = import.meta.env.BASE_URL;
const meta = loadAllMeta();
const categories = getCategories(meta);
---

<Layout title="О сайте">
  <style>
    .nav-pills .nav-link.active {
      background-color: var(--bs-dark) !important; /* Серый цвет из Bootstrap */
      color: #fff !important;
    }
    .nav-pills .nav-link:hover {
      background-color: var(--bs-gray-200); /* Легкий серый фон при наведении */
      color: var(--bs-dark);
    }
    nav.sticky-top {
      z-index: 1;
    }
  </style>
  <Fragment slot="navbar"><Navbar /></Fragment>
  <Fragment slot="footer"><Footer /></Fragment>

  <div class="row g-4">
    <div class="col-md-3">
      <nav class="nav flex-column nav-pills sticky-top p-3 rounded" style="top:5rem;">
        <a class="nav-link text-dark mb-1" href="#about">О сайте</a>
        <a class="nav-link text-dark mb-1" href="#sources">Источники</a>
        <a class="nav-link text-dark mb-1" href="#devs">Разработчикам</a>
        <a class="nav-link text-dark mb-1" href="#sitemap">Карта сайта</a>
      </nav>
    </div>

    <div class="col-md-9">
      <div id="about" class="tab-section">
        <div class="card border-0 shadow-sm">
          <div class="card-body">
            <h2 class="fs-4 fw-bold mb-3">
              <a href={base} class="text-decoration-none">&larr; Главная</a>
              <span class="text-muted fw-light mx-2">/</span>
              О сайте
            </h2>
          </div>
        </div>
        <div class="card border-0 shadow-sm">
          <div class="card-body">
            <p><strong>Открытый Тольятти</strong> — независимый портал для просмотра открытых данных города Тольятти. Данные получены из открытых источников Администрации г.о. Тольятти.</p>
            <p class="mb-0">Приложение является независимым и создано в информационных целях. Автор не связан с администрацией города Тольятти.</p>
            <p class="mt-3 mb-0">Связаться с нами по Email: <a href="mailto:tgldash@gmail.com">tgldash@gmail.com</a></p>
          </div>
        </div>
      </div>

      <div id="sources" class="tab-section">
        <div class="card border-0 shadow-sm">
          <div class="card-body">
            <h2 class="fs-4 fw-bold mb-3">Источники</h2>
            <p class="mb-2">Данные получены из следующих открытых источников:</p>
            <ul>
              <li><a href="https://tgl.ru/opendata/" target="_blank">Портал открытых данных администрации г.о. Тольятти</a></li>
              <li><a href="https://tgl.ru/structure/department/reestr-municipalnyh-marshrutov-regulyarnyh-perevozok/" target="_blank">Реестр маршрутов регулярных перевозок</a></li>
            </ul>
            <p class="mb-0 small text-muted">Данные распространяются по лицензии <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank">Creative Commons Attribution 4.0 (CC BY 4.0)</a>.</p>
          </div>
        </div>
      </div>

      <div id="devs" class="tab-section">
        <div class="card border-0 shadow-sm">
          <div class="card-body">
            <h2 class="fs-4 fw-bold mb-3">Разработчикам</h2>
            <p>Исходный код проекта доступен на <a href="https://github.com/zhidkovers/opentgl" target="_blank">GitHub</a>.</p>
            <p class="fw-semibold mb-2">Стек технологий:</p>
            <img height="14" width="14" src="https://cdn.simpleicons.org/astro/black" /> <strong>Astro</strong> — генерация статических страниц<br>
            <img height="14" width="14" src="https://cdn.simpleicons.org/bootstrap/black" /> <strong>Bootstrap 5</strong> — CSS-фреймворк<br>
            <img height="14" width="14" src="https://cdn.simpleicons.org/lucide/black" /> <strong>Lucide Icons</strong> — иконки<br>
            <img height="14" width="14" src="https://cdn.simpleicons.org/github/black" /> <strong>GitHub Pages</strong> — хостинг
            <p class="mb-0 small text-muted">Код распространяется под лицензией <a href="https://github.com/zhidkovers/opentgl/blob/main/LICENSE" target="_blank">GNU General Public License v3.0</a>.</p>
          </div>
        </div>
      </div>

      <div id="sitemap" class="tab-section">
        <div class="card border-0 shadow-sm">
          <div class="card-body">
            <h2 class="fs-4 fw-bold mb-3">Карта сайта</h2>
            <ul>
              <li><a href={base}>Главная</a></li>
              <li>
                <span class="fw-semibold">Категории:</span>
                <ul>
                  {categories.map(cat => (
                    <li><a href={`${base}category/${cat.key}`}>{cat.label}</a> </li>
                  ))}
                </ul>
              </li>
              <li><a href={`${base}about`}>О сайте</a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    (function() {
      var hash = location.hash || '#about';
      var show = function(id) {
        document.querySelectorAll('.tab-section').forEach(function(el) {
          el.style.display = el.id === id ? 'block' : 'none';
        });
        document.querySelectorAll('.nav-pills .nav-link').forEach(function(el) {
          el.classList.toggle('active', el.getAttribute('href') === '#' + id);
        });
      };
      show(hash.slice(1));
      window.addEventListener('hashchange', function() {
        show((location.hash || '#about').slice(1));
      });
    })();
  </script>
</Layout>
