---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import NavStrip from '../../components/NavStrip.astro';
import DataTable from '../../components/DataTable.astro';
import { loadAllMeta, loadDataByFile, getCategories } from '../../lib/csv-data.js';
import { CATEGORIES, fileSlug } from '../../lib/categories.js';
import { enrichEducationObjects, getMapCounts, loadOrganizationIndex } from '../../lib/geo.js';
import cultureFeeds from '../../data/culture-feeds.json';

const feedsByHost = new Map(
  (cultureFeeds.feeds || []).map(feed => [String(feed.host || '').toLowerCase(), feed]),
);

function siteHost(value) {
  const raw = String(value || '').trim();
  if (!raw) return '';
  try {
    const url = new URL(/^https?:\/\//i.test(raw) ? raw : `https://${raw}`);
    return url.hostname.replace(/^www\./i, '').toLowerCase();
  } catch {
    return '';
  }
}

export async function getStaticPaths() {
  const meta = await loadAllMeta();
  const cats = [...new Set(meta.map(m => m.category))].filter(c => CATEGORIES[c]);
  return cats.map(cat => ({
    params: { category: cat },
    props: { category: cat },
  }));
}

const base = import.meta.env.BASE_URL;
const { category } = Astro.props;
const meta = await loadAllMeta();
const catInfo = CATEGORIES[category] || { label: 'Прочее', icon: 'file-text', color: '#6c757d' };

function versionOf(filename) {
  const m = String(filename).match(/file[_-]?(\d+)$/i);
  return m ? Number(m[1]) : 0;
}

// В Google Sheets лежат несколько версий одного набора. Оставляем последнюю,
// чтобы не дублировать таблицы и точки на карте.
const files = [...meta.filter(m => m.category === category)]
  .sort((a, b) => {
    const byVersion = versionOf(b.filename) - versionOf(a.filename);
    if (byVersion !== 0) return byVersion;
    return String(b.date || '').localeCompare(String(a.date || ''));
  })
  .filter((file, index, list) => list.findIndex(f => f.subcategory === file.subcategory) === index);

const allMeta = await loadAllMeta();
const categories = getCategories(allMeta);

// Для образования адресов в исходных листах нет — подтягиваем их
// из телефонного справочника по названию учреждения.
const orgIndex = category === 'education' ? await loadOrganizationIndex(allMeta) : null;
// Образование на карту не выводится, поэтому для него не собираем GeoJSON.
const mapCounts = category === 'education' ? {} : await getMapCounts();

const fileData = await Promise.all(files.map(async file => {
  const data = await loadDataByFile(file.filename);
  let headers = data.headers;

  if (category === 'education' && orgIndex) {
    const matched = enrichEducationObjects(data.objects, orgIndex);
    if (matched && !headers.includes('Адрес')) headers = [...headers, 'Адрес'];
  }

  const filterId = fileSlug(file.filename);
  const eventIds =
    category === 'culture'
      ? data.objects.map(obj => feedsByHost.get(siteHost(obj['Сайт']))?.id || '')
      : null;

  return {
    subcategory: file.subcategory,
    filterId,
    mapCount: mapCounts[filterId] || 0,
    eventIds: eventIds?.some(Boolean) ? eventIds : null,
    data: { ...data, headers },
  };
}));

const totalMapCount = fileData.reduce((sum, file) => sum + file.mapCount, 0);
---

<Layout title={catInfo.label}>
  <Fragment slot="navbar"><Navbar /></Fragment>
  <Fragment slot="navstrip">
    <NavStrip items={categories.map(c => ({ key: c.key, label: c.label, icon: c.icon, color: c.color }))} active={category} />
  </Fragment>
  <Fragment slot="footer"><Footer /></Fragment>

  <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
    <a href={base} class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center"><i style="width:18px;height:18px;" class="me-1" data-lucide="chevron-left" />На главную</a>
    <span class="badge fs-6" style={`background: ${catInfo.color};`}>
      <i data-lucide={catInfo.icon} width="14" height="14" class="me-1"></i>
      {catInfo.label}
    </span>
    {totalMapCount > 0 && (
      <a
        href={`${base}map?category=${category}`}
        class="btn btn-primary btn-sm d-inline-flex align-items-center ms-auto"
        title={`Показать объекты категории «${catInfo.label}» на карте`}
      >
        <i data-lucide="map" width="16" height="16" class="me-1" />
        Посмотреть на карте
        <span class="badge text-bg-light ms-2">{totalMapCount}</span>
      </a>
    )}
  </div>

  {fileData.map(({ subcategory, data, filterId, mapCount, eventIds }) => (
    <div class="card border-0 shadow-sm mb-3">
      <div class="card-header bg-light d-flex justify-content-between align-items-center py-2 gap-2 flex-wrap">
        <h2 class="fs-6 fw-semibold mb-0">{subcategory}</h2>
        <div class="d-flex align-items-center gap-2 ms-auto">
          {mapCount > 0 && (
            <a
              href={`${base}map?category=${filterId}`}
              class="btn btn-sm btn-outline-primary d-inline-flex align-items-center"
              title={`Показать «${subcategory}» на карте`}
            >
              <i data-lucide="map-pin" width="14" height="14" class="me-1" />
              На карте
              <span class="badge text-bg-primary ms-1">{mapCount}</span>
            </a>
          )}
          <span class="badge bg-secondary">{data.objects.length} записей</span>
        </div>
      </div>
      <DataTable headers={data.headers} objects={data.objects} eventIds={eventIds} />
    </div>
  ))}
</Layout>
